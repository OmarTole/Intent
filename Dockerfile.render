FROM node:22-alpine AS web
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY server/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock && useradd --create-home appuser
COPY server/app ./app
COPY --from=web /build/dist ./static
USER appuser
EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn app.cloud:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --no-proxy-headers"]
